{
  "name": "reagent-roundup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --configLoader native --ssr server/progress-schema.ts --outDir dist-server && node --env-file-if-exists=.env.local server/index.mjs --dev",
    "build": "tsc -b && vite build --configLoader native && vite build --configLoader native --ssr server/progress-schema.ts --outDir dist-server",
    "build:server": "vite build --configLoader native --ssr server/progress-schema.ts --outDir dist-server",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "preview": "node --env-file-if-exists=.env.local server/index.mjs",
    "lint": "eslint .",
    "test": "vitest run --configLoader native --pool threads",
    "validate": "tsc -b && node tools/validate-questions.mjs",
    "validate:questions": "node tools/validate-questions.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
