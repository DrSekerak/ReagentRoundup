# Names only with placeholders. CU Launch supplies production settings.
# Never use VITE_ prefixes for server settings or commit a populated .env file.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full
AUTH_SECRET=<portal-supplied-random-secret-at-least-32-characters>
AUTH_MICROSOFT_ENTRA_ID_ID=<portal-supplied-client-id>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<portal-supplied-client-secret>
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<portal-supplied-tenant-id>/v2.0
AUTH_URL=https://<app-hostname>
NEXTAUTH_URL=https://<app-hostname>
PORT=3000
